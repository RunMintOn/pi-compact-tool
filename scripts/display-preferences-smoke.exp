#!/usr/bin/expect -f
set timeout 20
lassign $argv cwd agent_dir session extension log
set scripts [file dirname [file normalize [info script]]]
match_max 1000000
log_user 0
log_file -a -noappend $log
cd $cwd
spawn -noecho env TERM=xterm-256color TERM_PROGRAM= PI_CODING_AGENT_DIR=$agent_dir PI_OFFLINE=1 pi --offline --no-extensions --no-skills --no-context-files --no-prompt-templates --no-themes --tui-mode fullscreen --session $session --extension builtin:codemode --extension $extension
stty rows 50 columns 100 < $spawn_out(slave,name)
expect {
  -re {DISPLAY FINAL ANSWER} {}
  timeout { puts stderr "Replay did not render"; exit 1 }
  eof { puts stderr "Pi exited during startup"; exit 1 }
}
proc settle {} { expect -timeout 1 { -re {.+} { exp_continue } timeout {} } }
proc command {text pattern} {
  send -- "$text\r"
  expect {
    -re $pattern {}
    timeout { puts stderr "Command did not complete: $text"; exit 1 }
    eof { puts stderr "Pi exited: $text"; exit 1 }
  }
  settle
}
proc check {stage} {
  global scripts log
  log_file
  puts [exec python3 [file join $scripts check-display-screen.py] $log $stage]
  log_file -a $log
}
settle
check compact
command "/tool-color codemode blue" {codemode 工具名颜色：blue}
check compact
command "/tool-color codemode reset" {codemode 工具名颜色：amber}
check compact
command "/codemode-view calls" {codemode 展示：calls}
check calls
log_file
set row [exec python3 [file join $scripts find-tool-row.py] $log {NESTED COMMAND}]
log_file -a $log
send -- "\033\[<0;4;${row}M\033\[<0;4;${row}m"
expect {
  -re {SCRIPT OUTPUT} {}
  timeout { puts stderr "Nested row click did not expand entire codemode"; exit 1 }
}
settle
check expanded
command "/codemode-view compact" {codemode 展示：compact}
check expanded
log_file
set row [exec python3 [file join $scripts find-tool-row.py] $log {^ codemode\s*(?:const|$)}]
log_file -a $log
send -- "\033\[<0;4;${row}M\033\[<0;4;${row}m"
settle
check compact
command "/codemode-view calls" {codemode 展示：calls}
command "/tool-thinking hide" {thinking 展示：hide}
check hidden
command "/tool-thinking show" {thinking 展示：show}
check calls
command "/tool-thinking hide" {thinking 展示：hide}
command "/tool-color codemode pink" {codemode 工具名颜色：pink}
command "/reload" {Reloaded keybindings}
check hidden
command "/reload" {Reloaded keybindings}
check hidden
command "/reload" {Reloaded keybindings}
check hidden
command "/tool-color" {codemode=pink.*bash=blue}
command "/tool-color codemode reset" {codemode 工具名颜色：amber}
send -- "\004"
expect { eof {} timeout { puts stderr "Pi did not exit"; exit 1 } }
set result [wait]
if {[lindex $result 3] != 0} { exit 1 }
puts "PASS fullscreen global color restore/reset, preference commands, nested row click, expansion independence, thinking removal and reload (no model request)"
