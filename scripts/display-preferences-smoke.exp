#!/usr/bin/expect -f
set timeout 20
lassign $argv cwd agent_dir session extension log
set scripts [file dirname [file normalize [info script]]]
source [file join $scripts display-menu.exp]
match_max 1000000
log_user 0
log_file -a -noappend $log
cd $cwd
set extra_extensions {}
foreach path [lrange $argv 5 end] {
  lappend extra_extensions --extension $path
}
spawn -noecho env TERM=xterm-256color TERM_PROGRAM= PI_CODING_AGENT_DIR=$agent_dir PI_OFFLINE=1 pi --offline --no-extensions --no-skills --no-context-files --no-prompt-templates --no-themes --tui-mode fullscreen --session $session --extension builtin:codemode --extension $extension {*}$extra_extensions
stty rows 50 columns 100 < $spawn_out(slave,name)
expect {
  -re {DISPLAY FINAL ANSWER} {}
  timeout { puts stderr "Replay did not render"; exit 1 }
  eof { puts stderr "Pi exited during startup"; exit 1 }
}
proc settle {} { expect -timeout 1 { -re {.+} { exp_continue } timeout {} } }
proc command {text pattern} {
  send -- "$text\r"
  expect {
    -re $pattern {}
    timeout { puts stderr "Command did not complete: $text"; exit 1 }
    eof { puts stderr "Pi exited: $text"; exit 1 }
  }
  settle
}
proc check {stage} {
  global scripts log
  log_file
  puts [exec python3 [file join $scripts check-display-screen.py] $log $stage]
  log_file -a $log
}
settle
check compact
configure_display 2 4 1
check compact
configure_display 2 1 4
check compact
configure_display 3 0 1
check calls
log_file
set row [exec python3 [file join $scripts find-tool-row.py] $log {NESTED COMMAND}]
log_file -a $log
send -- "\033\[<0;4;${row}M\033\[<0;4;${row}m"
expect {
  -re {SCRIPT OUTPUT} {}
  timeout { puts stderr "Nested row click did not expand entire codemode"; exit 1 }
}
settle
check expanded
configure_display 3 1 0
check expanded
log_file
set row [exec python3 [file join $scripts find-tool-row.py] $log {^ codemode\s*(?:const|$)}]
log_file -a $log
send -- "\033\[<0;4;${row}M\033\[<0;4;${row}m"
settle
check compact
configure_display 3 0 1
configure_display 4 0 1
check hidden
configure_display 4 1 0
check calls
configure_display 4 0 1
configure_display 2 4 6
command "/reload" {Reloaded keybindings}
check hidden
command "/reload" {Reloaded keybindings}
check hidden
command "/reload" {Reloaded keybindings}
check hidden
send -- "/tools\r"
expect {
  -re {pink} {}
  timeout { puts stderr "Saved color did not appear in display menu"; exit 1 }
}
after 150
send -- "\033"
settle
configure_display 2 6 4
send -- "\004"
expect { eof {} timeout { puts stderr "Pi did not exit"; exit 1 } }
set result [wait]
if {[lindex $result 3] != 0} { exit 1 }
puts "PASS fullscreen display menu, global color restore/defaults, nested row click, expansion independence, thinking removal and reload (no model request)"
